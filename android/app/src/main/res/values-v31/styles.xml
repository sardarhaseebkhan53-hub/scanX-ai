<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash screen branded with the ScanX AI neon logo -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowSplashScreenBackground">#FF000000</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_fg</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#FF000000</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
